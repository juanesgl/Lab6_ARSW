# Copia este archivo como .env.local (ignorado por git) y ajusta los valores.

# REST (backend CRUD). Ruta relativa: el proxy de Vite reenvía /api a http://localhost:8080.
# También funciona la URL absoluta http://localhost:8080/api (el back tiene CORS para el front).
VITE_API_BASE_URL=/api
# Alternativa con el nombre del enunciado (solo el host, el front agrega /api):
# VITE_API_BASE=http://localhost:8080

# Tiempo real: solo el host; el front agrega el endpoint /ws-blueprints y convierte http -> ws.
VITE_STOMP_BASE=http://localhost:8080
VITE_IO_BASE=http://localhost:3001

# false = API real, true = apimock (datos en memoria, sin backend)
VITE_USE_MOCK=false
